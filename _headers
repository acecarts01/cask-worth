# Caskworth -- HTTP response headers
# Each URL pattern appears exactly once (Cloudflare Pages parser requirement).
# Link rel values use IANA-registered relation types (RFC 8288).

/
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json", </openapi.json>; rel="service-desc"; type="application/openapi+json", </llms.txt>; rel="service-doc"; type="text/plain", </.well-known/agent-skills/index.json>; rel="describedby"; type="application/json", </sitemap.xml>; rel="describedby"; type="application/xml", </.well-known/mcp/server-card.json>; rel="service-desc"; type="application/json", </auth.md>; rel="auth"; type="text/markdown", </.well-known/openid-configuration>; rel="openid-configuration"; type="application/json", <https://caskworth.com/>; rel="canonical"

/*.html
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json", </openapi.json>; rel="service-desc"; type="application/openapi+json", </llms.txt>; rel="service-doc"; type="text/plain", </.well-known/mcp/server-card.json>; rel="service-desc"; type="application/json", </auth.md>; rel="auth"; type="text/markdown", </.well-known/openid-configuration>; rel="openid-configuration"; type="application/json"

/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/openapi.json
  Content-Type: application/openapi+json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex

/api/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex
  Link: </openapi.json>; rel="service-desc"; type="application/openapi+json", </api/health.json>; rel="status"; type="application/json"

/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8

/auth.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8

/.well-known/oauth-authorization-server
  Content-Type: application/json; charset=utf-8

/.well-known/openid-configuration
  Content-Type: application/json; charset=utf-8

/.well-known/acp.json
  Content-Type: application/json; charset=utf-8

/.well-known/ucp
  Content-Type: application/json; charset=utf-8

/.well-known/mcp/server-card.json
  Content-Type: application/json; charset=utf-8

/.well-known/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
